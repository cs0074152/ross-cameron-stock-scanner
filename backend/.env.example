# Backend configuration
# Server bind address: only loopback is permitted
HOST=127.0.0.1
PORT=3001

# Comma-separated list of origins allowed to call the API / WebSocket
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional local durable state file; default backend/data/positions.json
# STATE_FILE=C:/path/to/scanner-state.json
